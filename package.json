{
  "name": "siyuan-todo",
  "version": "1.2.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "icons": "node scripts/prepare-assets.mjs --png",
    "build": "tsc --noEmit && node scripts/prepare-assets.mjs && vite build && node scripts/build-plugin.mjs",
    "build:plugin": "tsc --noEmit && node scripts/build-plugin.mjs",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:ui": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "siyuan": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
